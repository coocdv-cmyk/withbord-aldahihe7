{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coocdv-cmyk/withbord-aldahihe7/rasm-pro/engine/core/schema/project.schema.json",
  "title": "rasm-pro project manifest",
  "description": "project.json contract. All file paths are relative to the project directory. Hashes, not timestamps, establish integrity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "title",
    "language",
    "canvas",
    "fps",
    "status",
    "created_at",
    "updated_at",
    "paths",
    "storyboard",
    "audio",
    "asset_policy",
    "assets",
    "unresolved",
    "renders",
    "render",
    "studio"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "canvas": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 1 },
        { "type": "integer", "minimum": 1 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "fps": { "$ref": "#/$defs/frameRate" },
    "status": {
      "enum": ["draft", "researched", "planned", "approved", "rendered"]
    },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "script_text", "research", "assets_index"],
      "properties": {
        "script": { "$ref": "#/$defs/relativePathOrNull" },
        "script_text": { "$ref": "#/$defs/relativePathOrNull" },
        "research": { "$ref": "#/$defs/relativePathOrNull" },
        "assets_index": { "$ref": "#/$defs/relativePathOrNull" }
      }
    },
    "storyboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "sha256", "format_version"],
      "properties": {
        "active": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "format_version": { "enum": ["1.0", "2.0"] }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narration", "alignment"],
      "properties": {
        "narration": { "$ref": "#/$defs/relativePathOrNull" },
        "alignment": { "$ref": "#/$defs/relativePathOrNull" },
        "sha256": { "$ref": "#/$defs/sha256OrNull" },
        "alignment_sha256": { "$ref": "#/$defs/sha256OrNull" },
        "codec": { "type": ["string", "null"] },
        "sample_rate": { "type": ["integer", "null"], "minimum": 1 },
        "channels": { "type": ["integer", "null"], "minimum": 1 },
        "total_samples": { "type": ["integer", "null"], "minimum": 1 },
        "duration_exact": { "type": ["string", "null"] },
        "duration_sec": { "type": ["number", "null"], "minimum": 0 },
        "alignment_level": {
          "enum": ["NONE", "APPROXIMATE", "MEASURED", "SEGMENTED", "WORD", null]
        },
        "alignment_method": { "type": ["string", "null"] },
        "loudness": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "lufs_integrated",
            "lra",
            "true_peak_dbtp",
            "rms_dbfs",
            "sample_rate",
            "channels",
            "total_samples",
            "duration_sec"
          ],
          "properties": {
            "lufs_integrated": { "type": "number" },
            "lra": { "type": "number", "minimum": 0 },
            "true_peak_dbtp": { "type": "number" },
            "rms_dbfs": { "type": "number" },
            "sample_rate": { "type": "integer", "minimum": 1 },
            "channels": { "type": "integer", "minimum": 1 },
            "total_samples": { "type": "integer", "minimum": 1 },
            "duration_sec": { "type": "number", "minimum": 0 },
            "method": { "type": "string" }
          }
        },
        "normalization": { "type": ["object", "null"] }
      }
    },
    "asset_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_is_evidence",
        "retrieved_requires_approval",
        "requires_origin",
        "requires_license",
        "final_render_requires_approval"
      ],
      "properties": {
        "generated_is_evidence": { "type": "boolean" },
        "retrieved_requires_approval": { "type": "boolean" },
        "requires_origin": { "type": "boolean" },
        "requires_license": { "type": "boolean" },
        "final_render_requires_approval": { "type": "boolean" }
      }
    },
    "approval_log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "records", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "records": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^$|^[a-fA-F0-9]{64}$" }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "origin",
          "license",
          "approved_by",
          "approved_at",
          "status"
        ],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "asset_id": { "type": "string", "pattern": "^a-[0-9a-f]{12}$" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 1 },
          "kind": { "type": ["string", "null"] },
          "mime": { "type": ["string", "null"] },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "url", "page_url", "retrieved_at", "title", "author"],
            "properties": {
              "kind": { "type": ["string", "null"] },
              "url": { "type": ["string", "null"] },
              "page_url": { "type": ["string", "null"] },
              "retrieved_at": { "type": ["string", "null"] },
              "title": { "type": ["string", "null"] },
              "author": { "type": ["string", "null"] }
            }
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url", "attribution_required"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "url": { "type": "string" },
              "attribution_required": { "type": "boolean" }
            }
          },
          "approved_by": { "type": ["string", "null"] },
          "approved_at": { "type": ["string", "null"] },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision", "reviewer", "reviewed_at", "note", "records"],
            "properties": {
              "decision": { "enum": ["pending", "approved", "rejected", "deferred"] },
              "reviewer": { "type": "string" },
              "reviewed_at": { "type": "string" },
              "note": { "type": "string" },
              "records": { "type": "integer", "minimum": 0 }
            }
          },
          "status": {
            "enum": ["retrieved", "generated", "pending", "approved", "rejected"]
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "blocking", "message"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean" },
          "message": { "type": "string", "minLength": 1 },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pending", "approved", "rejected"],
            "properties": {
              "pending": { "type": "integer", "minimum": 0 },
              "approved": { "type": "integer", "minimum": 0 },
              "rejected": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "renders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sha256", "bytes", "created_at", "status", "validation"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "role": { "enum": ["preview", "deliverable"] },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 1 },
          "created_at": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "validation": { "type": ["object", "string", "null"] }
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fps_source",
        "width",
        "height",
        "default_out_size",
        "video_codec",
        "audio_codec"
      ],
      "properties": {
        "fps_source": { "const": "plan" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "default_out_size": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 1 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "video_codec": { "type": "string" },
        "audio_codec": { "type": "string" }
      }
    },
    "studio": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "project_id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "frameRate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num", "den"],
      "properties": {
        "num": { "type": "integer", "minimum": 1 },
        "den": { "type": "integer", "minimum": 1 }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "sha256OrNull": {
      "type": ["string", "null"],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "relativePathOrNull": {
      "type": ["string", "null"],
      "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
